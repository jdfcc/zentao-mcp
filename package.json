{
  "name": "@jdfcc/zentao-mcp",
  "version": "1.3.0",
  "description": "MCP server for Zentao API integration with Codex and Claude support",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "zentao-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example",
    "codex.example.toml",
    "mcp-cli.mjs",
    "install.ps1",
    "skill",
    "scripts"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test:codex": "npm run build && node test-codex-compat.mjs",
    "test:legacy": "npm run build && node test-legacy-client.mjs",
    "test:live": "npm run build && node test-live-zentao.mjs",
    "test": "npm run test:codex && npm run test:legacy",
    "pack:skill": "pwsh -NoProfile -File scripts/pack-skill.ps1",
    "test:e2e": "node test-e2e.mjs",
    "test:mcp": "npm run build && node test-mcp-launch.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zentao",
    "project-management",
    "claude",
    "codex",
    "openai"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdfcc/zentao-mcp.git"
  },
  "author": "jdfcc",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.7.9",
    "dotenv": "^17.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
